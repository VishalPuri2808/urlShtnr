# Copy this file to .env and fill in production values.
# .env is git-ignored and must NEVER be committed.

DB_NAME=urlshortener
DB_USER=urlshortener
DB_PASSWORD=change_me_in_production
# For cloud databases that require SSL (e.g. Neon.tech): ?sslmode=require
DB_SSL_PARAMS=

REDIS_HOST=localhost
REDIS_PORT=6379

# For host access to the Docker Compose Kafka external listener (port 9094)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

SERVER_PORT=8080
BASE_URL=http://localhost:8080

# Redis TTL for short-code lookup cache (seconds)
CACHE_TTL_SECONDS=3600

# Kafka topic name (must match KafkaConfig bean)
KAFKA_CLICK_EVENTS_TOPIC=url.click.events
